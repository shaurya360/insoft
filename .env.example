# Contact form → Supabase (same project as the INSOFT admin app).
# Server-side only (no NEXT_PUBLIC_ prefix): the key never reaches the browser.
# Supabase Dashboard → Project Settings → API Keys → anon / publishable key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional: email alert for every new enquiry, sent through Resend (https://resend.com).
# Create a free account and an API key. Until you verify a sending domain in Resend,
# alerts can only go to the email address the Resend account was created with.
RESEND_API_KEY=
ENQUIRY_ALERT_EMAIL=shauryasharma630@gmail.com
# After verifying insofttechnology.in in Resend, you can send from your own domain:
# ENQUIRY_ALERT_FROM=Insoft Website <website@insofttechnology.in>
